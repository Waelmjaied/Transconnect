# --- Server ---
PORT=4000
NODE_ENV=development
# OBLIGATOIRE en production (>= 32 caractères aléatoires) : openssl rand -base64 48
JWT_SECRET=
TOKEN_TTL=8h
DB_PATH=./data/transconnect.db
# Origines autorisées (séparées par des virgules)
CORS_ORIGIN=http://localhost:3000
# Premier administrateur (créé au démarrage s'il n'existe pas)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Données de démo (comptes + trajets) : true par défaut hors production
SEED_DEMO=true
